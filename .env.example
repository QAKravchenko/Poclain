# ========================================================
# Template Environment Configuration (.env.preprod / .env.prod)
# ========================================================

# Базовый URL целевого окружения
BASE_URL=https://poclain.com

# Название активного окружения (pre-prod | prod)
ENV=prod

# ========================================================
# Учетные данные HTTP Basic Auth
# ========================================================
AUTH_USER=your_user_name
AUTH_PASSWORD=your_password
